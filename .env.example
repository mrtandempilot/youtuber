# Public site settings
NEXT_PUBLIC_SITE_NAME=CreatorKit
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_TWITTER_HANDLE=

# Search Console / Bing Webmaster verification codes (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Plausible analytics: set to your domain to enable (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# AI (hashtag generator)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
FREE_DAILY_LIMIT=30

# YouTube channel analyzer
# Public channel data (Google Cloud > APIs & Services > Credentials > API key, restricted to YouTube Data API v3)
YOUTUBE_API_KEY=
# "Connect with Google" (OAuth client, type Web application)
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ char string used to encrypt the session cookie: openssl rand -base64 32
SESSION_SECRET=
ANALYZE_DAILY_LIMIT=20
SUGGEST_DAILY_LIMIT=30

# Supabase (accounts, saved plans, channel history). Optional: the site works without it.
# Project Settings > API: Project URL and a Secret key (sb_secret_…, or the legacy service_role key). Server-only!
SUPABASE_URL=
SUPABASE_SECRET_KEY=
